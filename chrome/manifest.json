{
  "manifest_version": 3,
  "name": "All-in-One Custom Search",
  "version": "2.1",
  "description": "Allows you to switch your default search engine (Startpage, DuckDuckGo, Brave, Ecosia, PrivacyWall) via a simple dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Select Search Engine",
    "default_popup": "popup/dashboard.html"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*"
  ]
}
